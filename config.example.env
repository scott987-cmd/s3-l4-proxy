# Copy to config.env before use. Do not commit real credentials.

# Generic S3-compatible backend reached by ECS inside the customer network.
# Examples:
#   Volcengine TOS: tos-s3-cn-beijing.ivolces.com
#   AWS S3 VPC endpoint: bucket.vpce-xxx.s3.cn-north-1.vpce.amazonaws.com.cn
#   Alibaba OSS: bucket.oss-cn-beijing-internal.aliyuncs.com
#   Huawei OBS: bucket.obs.cn-north-4.myhuaweicloud.com
S3_BACKEND_HOST=tos-s3-cn-beijing.ivolces.com
S3_BACKEND_PORT=443

# Client-facing hostname retained for TLS SNI and request signing.
# For virtual-hosted S3 this is commonly <bucket>.<public-s3-endpoint>.
S3_CLIENT_HOST=private-proxy.tos-s3-cn-beijing.volces.com

# SigV4 settings used only by verification scripts. The L4 proxy itself is
# protocol-transparent and does not depend on a specific signing algorithm.
S3_REGION=cn-beijing
S3_SERVICE=s3
S3_SIGV4_PROVIDER=aws:amz

# Local nginx stream listener on each ECS proxy node.
LISTEN_PORT=443

# Optional public load balancer frontend IP/EIP, used only by client-side
# diagnostics and speed tests. LB_IP is the current name; CLB_IP and EIP are
# still accepted for backward compatibility.
LB_IP=

# Optional S3 test settings. Use environment variables for real AK/SK.
OBJECT_PREFIX=l4-proxy-test
SIZE_MB=100

# Deploy behavior.
NGINX_MAIN=/etc/nginx/nginx.conf
NGINX_USER=
STREAM_DIR=/etc/nginx/stream.d
CONF_PATH=/etc/nginx/stream.d/s3-proxy.conf
MAIN_MODE=replace
NOFILE=65535
VERIFY_AFTER_INSTALL=1

# Enable only when the load balancer listener is also configured to send PROXY protocol.
# The two sides must match, otherwise normal TLS clients cannot connect.
ENABLE_PROXY_PROTOCOL=0

# Gracefully reload nginx to refresh non-variable backend DNS results.
INSTALL_DNS_RELOAD_TIMER=1
DNS_RELOAD_INTERVAL=5min

# Security hardening. EGRESS_LOCK is off by default to avoid breaking hosts
# with other outbound dependencies. Enable only after reviewing allow rules.
HARDEN=1
DEDICATED_PROXY_HOST=1
EGRESS_LOCK=0
EGRESS_UNLOCK=0
SSH_PORT=22
EXTRA_ALLOW=

# Optional package install override. Set INSTALL_NGINX=0 on hosts where nginx
# is managed by a base image or another provisioning system.
INSTALL_NGINX=1
